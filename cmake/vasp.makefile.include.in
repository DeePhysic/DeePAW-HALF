include @HALF_VASP_ARCH_INCLUDE@

VASP_TARGET_CPU = -tp host
GPU = -gpu=cc@HALF_GPU_CC@,cuda@HALF_CUDA_VERSION@

CPP = @CMAKE_Fortran_COMPILER@ -Mpreprocess -Mfree -Mextend -E $(CPP_OPTIONS) $*$(FUFFIX) > $*$(SUFFIX)
FC = @HALF_VASP_MPIFC@ @HALF_VASP_COMPILE_FLAGS@
FCL = @HALF_VASP_MPIFC@ @HALF_VASP_COMPILE_FLAGS@ -c++libs
CC = @HALF_VASP_MPICC@ @HALF_VASP_COMPILE_FLAGS@
FC_LIB = @CMAKE_Fortran_COMPILER@
CC_LIB = @HALF_VASP_NVC@ -w
CXX_PARS = @HALF_VASP_NVCXX@ --no_warnings

FFTW_ROOT = @HALF_VASP_FFTW_ROOT@
HALF_ROOT = @CMAKE_BINARY_DIR@
MKLROOT = @HALF_MKL_ROOT@

INCS += -I$(HALF_ROOT)/modules -I@CMAKE_CURRENT_SOURCE_DIR@/include
INCS += -I$(MKLROOT)/include/fftw
LLIBS += -L$(HALF_ROOT) -lhalf -Wl,-rpath,$(HALF_ROOT)
LLIBS += -L@HALF_MKL_LIBRARY_DIR@ -lmkl_rt -Wl,-rpath,@HALF_MKL_LIBRARY_DIR@ -lpthread -lm -ldl
LLIBS += -Wl,-rpath,$(QD)/lib
FCL += -cuda -gpu=cuda@HALF_CUDA_VERSION@,cc@HALF_GPU_CC@
