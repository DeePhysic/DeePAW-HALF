@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@HALF_HAVE_MPI@)
  find_dependency(MPI COMPONENTS Fortran)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/HALFTargets.cmake")
set(HALF_VERSION "@PROJECT_VERSION@")
set(HALF_WITH_MPI @HALF_HAVE_MPI@)
set(HALF_WITH_CUDA @HALF_ENABLE_CUDA@)
set(HALF_WITH_HDF5 @HALF_HAVE_HDF5@)
set(HALF_WITH_SPGLIB @HALF_HAVE_SPGLIB@)
set(HALF_CUDA_VERSION "@HALF_CUDA_VERSION@")
set(HALF_GPU_CC "@HALF_GPU_CC@")
